            "decrease",
            "stable",
            "unknown"
          ]
        }
      },
      "required": [
        "goal",
        "expected_distance_change"
      ]
    },
    "entrance_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
