        "target_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_support": {
          "type": "string",
          "enum": [
            "observed",
            "uncertain",
            "contradicted"
          ]
        },
        "evidence_frames": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "role",
        "target_candidate_id",
        "route_support"
