{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "skill": {
      "type": "string",
      "enum": [
        "move",
        "stop"
      ]
    },
    "stage": {
      "type": "integer"
    },
    "place": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clause_id": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "contradicted",
              "seen",
              "reached",
              "passed"
            ]
          },
          "frames": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          },
          "observation": {
            "type": "string"
          }
        },
        "required": [
          "clause_id",
          "state",
          "frames",
          "observation"
        ]
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "turn_left"
              },
              "degrees": {
                "type": "integer",
                "enum": [
                  15,
                  30,
                  45,
                  60,
                  75,
                  90
                ]
              }
            },
            "required": [
              "type",
              "degrees"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "turn_right"
              },
              "degrees": {
                "type": "integer",
                "enum": [
                  15,
                  30,
                  45,
                  60,
                  75,
                  90
                ]
              }
            },
            "required": [
              "type",
              "degrees"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "forward"
              },
              "centimeters": {
                "type": "integer",
                "enum": [
                  25,
                  50,
                  75,
                  100
                ]
              }
            },
            "required": [
              "type",
              "centimeters"
            ]
          }
        ]
      }
    },
    "maneuver": {
      "type": "string",
      "enum": [
        "travel",
        "climb_up",
        "climb_down",
        "return_to_anchor",
        "instruction_orientation"
      ]
    },
    "return_anchor_frame": {
      "type": [
        "integer",
        "null"
      ]
    },
    "branch_target": {
      "type": "string"
    },
    "instruction_clause": {
      "type": "string"
    },
    "evidence_frames": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "integer"
      }
    },
    "route_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_clause": {
          "type": "string"
        },
        "landmarks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "contradicted",
                  "unknown"
                ]
              },
              "frames": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "description",
              "verdict",
              "frames"
            ]
          }
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "contradicted",
                  "unknown"
                ]
              },
              "frames": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "description",
              "verdict",
              "frames"
            ]
          }
        },
        "door_crossing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "confirmed",
                "contradicted",
                "unknown"
              ]
            },
            "description": {
              "type": "string"
            },
            "before_frame": {
              "type": [
                "integer",
                "null"
              ]
            },
            "after_frame": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "verdict",
            "description",
            "before_frame",
            "after_frame"
          ]
        },
        "route_verdict": {
          "type": "string",
          "enum": [
            "confirmed",
            "contradicted",
            "unknown"
          ]
        },
        "route_frames": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "expected_next": {
          "type": "string"
        }
      },
      "required": [
        "current_clause",
        "landmarks",
        "prerequisites",
        "door_crossing",
        "route_verdict",
        "route_frames",
        "expected_next"
      ]
    },
    "history_panorama_ids": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "integer"
      }
    },
    "map_operation": {
      "type": "string",
      "enum": [
        "none",
        "annotate_node",
        "navigate_to_node"
      ]
    },
    "map_node_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "map_annotation": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "view": {
          "type": "string",
          "enum": [
            "front",
            "right",
            "rear",
            "left"
          ]
        },
        "point_norm": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "seen",
            "approaching",
            "possibly_passed",
            "reached"
          ]
        }
      },
      "required": [
        "description",
        "view",
        "point_norm",
        "status"
      ]
    },
    "expected_effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string"
        },
        "expected_distance_change": {
