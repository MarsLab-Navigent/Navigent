        "description": {
          "type": "string"
        },
        "view": {
          "type": "string",
          "enum": [
            "front",
            "right",
            "rear",
            "left"
          ]
        },
        "point_norm": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "seen",
            "approaching",
            "possibly_passed",
            "reached"
          ]
